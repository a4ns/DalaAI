# Allowlist for this Dockerfile's repository-root context; secrets stay out.
**
!backend/
!backend/requirements.lock
!backend/app/
!backend/app/**
!backend/db/
!backend/db/**
!frontend/
!frontend/**
!ops/
!ops/provision/
!ops/provision/**
!ops/managed/
!ops/managed/Caddyfile
!ops/managed/supervise.py
!ops/managed/Dockerfile
!ops/managed/Dockerfile.dockerignore
**/node_modules
**/dist
**/__pycache__
**/*.pyc
**/.git
**/.local
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials*.json
**/*.log
